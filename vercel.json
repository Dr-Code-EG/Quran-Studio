{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/generate", "destination": "/api/generate.ts" },
    { "source": "/api/job-status", "destination": "/api/job-status.ts" },
    { "source": "/api/verse-preview", "destination": "/api/verse-preview.ts" },
    { "source": "/api/health", "destination": "/api/health.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
